# /etc/systemd/system/mentor-web.service — LXC 103 (service root, remplace tmux)
[Unit]
Description=Mentor IA — web app Flask (port 8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mentor-ia
EnvironmentFile=/opt/mentor-ia/.env
ExecStart=/opt/mentor-ia/venv/bin/python web_app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
